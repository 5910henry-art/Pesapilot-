FLASK_APP=run.py
FLASK_ENV=development

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# PostgreSQL connection string (required).
DATABASE_URL=postgresql://username:password@localhost:5432/pesapilot

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same key permanently; changing it prevents decrypting existing identity data.
IDENTITY_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

CORS_ORIGINS=http://localhost:5173

# Optional external AI provider (disabled by default).
AI_EXTERNAL_ENABLED=false
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
